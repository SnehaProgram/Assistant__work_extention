{
  "manifest_version": 3,
  "name": "SaralSetu Smart Form & Accessibility Assistant",
  "version": "1.0.0",
  "description": "Chrome Extension for SaralSetu: Real-Time DOM Auto-Fill, Voice Reader & Vernacular Translation.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:5500/*",
    "http://127.0.0.1:5500/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SaralSetu Assistant"
  }
}
